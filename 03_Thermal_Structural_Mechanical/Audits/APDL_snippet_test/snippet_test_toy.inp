! =====================================================================================================
! SECTION 7B - SYNTAX TEST of the post-processing snippet on a TOY model (RE-ANALYSIS 2026).
! A small hollow cylinder (ri 10 mm, ro 20 mm, L 60 mm, SOLID186) with an arbitrary made-up temperature field,
! constrained like LC2 (U_z = 0 on both end faces, 3 mid-span outer nodes rotated to a cylindrical CS, U_theta = 0).
! Its only purpose is to prove that every APDL command in s7b_post_snippet.inp runs without error before the snippet
! is put into the real Mechanical solves. Its numbers are NOT project results and are not reported anywhere.
! =====================================================================================================
/batch
/title,S7B snippet syntax test - toy model, not a project result
/prep7
et,1,186
mptemp
mptemp,1,20,100,200,300,400
mpdata,ex,1,,204e9,199e9,193e9,187e9,180e9
mpdata,nuxy,1,,0.294,0.294,0.294,0.294,0.294
mptemp
mptemp,1,93.33,204.44,315.56,426.67,537.78
mpdata,alpx,1,,12.8e-6,13.3e-6,13.9e-6,14.2e-6,14.8e-6
mpamod,1,21.11
mp,dens,1,8190
tref,26.85
cylind,0.010,0.020,0,0.06,0,360
esize,0.004
vsweep,all
local,12,1,0,0,0
csys,0
allsel,all
*get,nmx,node,0,num,max
*do,i,1,nmx
*if,nsel(i),eq,1,then
bf,i,temp,150+100*nz(i)/0.06+20*(sqrt(nx(i)**2+ny(i)**2)-0.01)/0.01
*endif
*enddo
nsel,s,loc,z,0
nsel,a,loc,z,0.06
d,all,uz,0
allsel,all
n1=node(0.02,0,0.03)
n2=node(-0.01,0.01732,0.03)
n3=node(-0.01,-0.01732,0.03)
csys,12
nrot,n1
nrot,n2
nrot,n3
csys,0
d,n1,uy,0
d,n2,uy,0
d,n3,uy,0
allsel,all
finish
/solu
antype,0
eqsl,sparse
outres,erase
outres,all,none
outres,nsol,all
outres,rsol,all
outres,strs,all
outres,epel,all
outres,epth,all
outres,etmp,all
solve
finish
/input,s7b_post_snippet,inp
/com,S7B-TOY-TEST-END
finish
